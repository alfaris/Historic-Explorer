{
  "rewrites": [
    {
      "source": "/r/:route",
      "destination": "/api/share?route=:route"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/share.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
