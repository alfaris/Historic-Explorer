# GEMINI_API_KEY: used only by the server functions in api/ (and the local dev server).
# It is never bundled into the frontend. On Vercel, set it in the project's environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_PASSWORD: the password for the admin dashboard at /admin (at least 12
# characters). Leave it unset to turn the dashboard off. Changing it signs every
# admin out.
ADMIN_PASSWORD=""

# Optional. Signs admin session cookies; defaults to a value derived from
# ADMIN_PASSWORD. Set it to a long random string to sign everyone out without
# changing the password.
# ADMIN_SESSION_SECRET=""

# BLOB_READ_WRITE_TOKEN is added by Vercel when a Blob store is connected. It's
# needed for saved audio, visitor reports and admin edits.
